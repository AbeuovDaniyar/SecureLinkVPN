<Window x:Class="SecureLink.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureLink Login" Height="500" Width="320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="#16161E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="SecureLink" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
            <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource TitleBarButtonStyle}" Click="Close_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="28,0">
            <TextBlock Text="SecureLink" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SubtitleText" Text="Sign in to connect" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,32"/>

            <TextBlock Text="EMAIL" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
            <Border Style="{StaticResource DarkFieldContainer}" Margin="0,0,0,16">
                <TextBox x:Name="EmailBox" Style="{StaticResource DarkTextBox}"/>
            </Border>

            <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
            <Border Style="{StaticResource DarkFieldContainer}" Margin="0,0,0,16">
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource DarkPasswordBox}"
                             KeyDown="PasswordBox_KeyDown"/>
            </Border>

            <StackPanel x:Name="ConfirmPasswordPanel" Visibility="Collapsed">
                <TextBlock Text="CONFIRM PASSWORD" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,6"/>
                <Border Style="{StaticResource DarkFieldContainer}" Margin="0,0,0,16">
                    <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource DarkPasswordBox}"
                                 KeyDown="PasswordBox_KeyDown"/>
                </Border>
            </StackPanel>

            <Button x:Name="SubmitButton" Content="Log in" Height="42" Margin="0,8,0,0"
                    Style="{StaticResource AccentButton}" Click="SubmitButton_Click"/>

            <Button x:Name="ToggleModeButton" Content="Don't have an account? Sign up"
                    Style="{StaticResource LinkButton}" Margin="0,14,0,0" Click="ToggleMode_Click"/>

            <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
